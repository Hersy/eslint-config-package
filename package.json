{
  "name": "@hersy/eslint-config-react",
  "version": "0.1.2",
  "description": "A modern ESLint configuration for React projects, following my styleguide",
  "keywords": [
    "config",
    "hersy",
    "eslint",
    "eslintconfig",
    "node",
    "react",
    "styleguide"
  ],
  "homepage": "https://github.com/hersy/eslint-config-react",
  "bugs": {
    "url": "https://github.com/hersy/eslint-config-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hersy/eslint-config-react"
  },
  "license": "MIT",
  "author": "Hersy <contact@hersy.dev>",
  "type": "module",
  "files": [
    "rules",
    "index.js"
  ],
  "main": "index.js",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "lint": "eslint . --report-unused-disable-directives --ext .js,json,md",
    "lint-fix": "eslint . --fix --ext .js,json,md",
    "format": "yarn run --silent lint-fix",
    "eslint-check": "eslint --print-config eslint.config.js",
    "pretests-only": "node ./test/requires",
    "pretest": "yarn --silent lint",
    "tests-only": "babel-tape-runner ./test/test-*.js",
    "test": "yarn --silent tests-only",
    "prepublish-only": "eslint-find-rules --unused",
    "prepublish": "not-in-publish || yarn prepublish-only"
  },
  "dependencies": {
    "@hersy/eslint-config-node": "^0.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.27.0",
    "@hersy/babel-preset": "^0.2.0",
    "@hersy/babel-tape-runner": "^1.0.0",
    "eslint": "^9.24.0",
    "eslint-find-rules": "^5.0.0",
    "in-publish": "^2.0.0",
    "tape": "^5.9.0"
  },
  "peerDependencies": {
    "eslint": "^9.24.0"
  },
  "resolutions": {
    "glob": "^9.3.0"
  },
  "packageManager": "yarn@1.22.22"
}